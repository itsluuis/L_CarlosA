# ==============================================================================
# SECURITY & REPOSITORY HARDENING IGNORE RULES
# ==============================================================================

# --- Sensitive Client Assets & Raw Source Directories ---
FV/
raw/
drafts/
sources/

# --- AI Agents & IDE Tooling (Prevents Executable Scripts/Batch Files in Git) ---
.agents/
.gemini/
.vscode/
.idea/
.cursor/
.claude/

# --- Environment Variables & Secrets ---
.env
.env.*
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
secrets.*

# --- Operating System & File System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Browser Automation & Test Artifacts ---
.playwright-mcp/
landing-*.png
*-screenshot.png
*.png.tmp
*.webp.tmp

# --- Temporary & Scratch Files ---
scratch/
temp/
tmp/
*.tmp
*.bak
*.swp
*.swo
*~

# --- Logs & Runtime Output ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Node & Python Artifacts ---
node_modules/
__pycache__/
*.py[cod]
*$py.class
